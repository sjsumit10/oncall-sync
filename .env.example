# Host ports published by docker compose. Override if something already binds
# these locally (an SSH tunnel, a system postgres, ...). Container-to-container
# traffic is unaffected.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

ENVIRONMENT=local
DEBUG=true
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173

# The app connects as a non-superuser, non-owner role so row-level security
# actually applies; the owner role is used only for migrations and bootstrap.
DATABASE_URL=postgresql+asyncpg://oncall_app:oncall_app@localhost:5432/oncall
DATABASE_ADMIN_URL=postgresql+asyncpg://oncall:oncall@localhost:5432/oncall
REDIS_URL=redis://redis:6379/0

# Wraps per-org data encryption keys. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIAL_KEK=
SESSION_SECRET=dev-only-change-me
# http on localhost cannot carry Secure cookies. Never false in a deployed env.
COOKIE_SECURE=false

# PagerDuty OAuth app (API-key fallback needs no credentials here)
PAGERDUTY_CLIENT_ID=
PAGERDUTY_CLIENT_SECRET=

# Slack app.
#   Redirect URL:  <APP_BASE_URL>/api/v1/chat/slack/callback
#   Event URL:     <APP_BASE_URL>/api/v1/webhooks/slack/events
#   Bot scopes:    usergroups:read, usergroups:write, channels:read, groups:read,
#                  chat:write, users:read, users:read.email, team:read
#   User scope:    usergroups:write  (fallback for workspaces that restrict
#                  user-group management to admins)
#   Subscribe to:  app_uninstalled, tokens_revoked, subteam_updated
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
