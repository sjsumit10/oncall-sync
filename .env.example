# Host ports published by docker compose. Override if something already binds
# these locally (an SSH tunnel, a system postgres, ...). Container-to-container
# traffic is unaffected.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WORKER_METRICS_PORT=9100

ENVIRONMENT=local
DEBUG=true
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173

# Where Slack/PagerDuty redirect the browser back to after an OAuth install, and
# where Slack posts events. These have to be reachable by Slack/PagerDuty's own
# servers, which plain localhost is not. Leave unset to fall back to
# APP_BASE_URL; set it only when APP_BASE_URL itself can't be a public URL, e.g.
# local dev behind a tunnel (ngrok, etc.) while everything else stays on
# localhost. Must exactly match the Redirect URLs/Request URL configured in the
# provider's app settings.
OAUTH_CALLBACK_BASE_URL=

# The app connects as a non-superuser, non-owner role so row-level security
# actually applies; the owner role is used only for migrations and bootstrap.
#
# These three are what the app uses when you run it NATIVELY. Under docker
# compose they are overridden with container hostnames, so editing them there
# has no effect. Hosts and ports must match POSTGRES_PORT / REDIS_PORT above.
DATABASE_URL=postgresql+asyncpg://oncall_app:oncall_app@localhost:5432/oncall
DATABASE_ADMIN_URL=postgresql+asyncpg://oncall:oncall@localhost:5432/oncall
REDIS_URL=redis://localhost:6379/0

# Wraps per-org data encryption keys. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIAL_KEK=
SESSION_SECRET=dev-only-change-me
# http on localhost cannot carry Secure cookies. Never false in a deployed env.
COOKIE_SECURE=false

# PagerDuty OAuth app (API-key fallback needs no credentials here)
PAGERDUTY_CLIENT_ID=
PAGERDUTY_CLIENT_SECRET=

# Slack app.
#   Redirect URL:  <OAUTH_CALLBACK_BASE_URL or APP_BASE_URL>/api/v1/chat/slack/callback
#   Event URL:     <OAUTH_CALLBACK_BASE_URL or APP_BASE_URL>/api/v1/webhooks/slack/events
#   Bot scopes:    usergroups:read, usergroups:write, channels:read, groups:read,
#                  chat:write, users:read, users:read.email, team:read
#   User scope:    usergroups:write  (fallback for workspaces that restrict
#                  user-group management to admins)
#   Subscribe to:  app_uninstalled, tokens_revoked, subteam_updated
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Microsoft Teams app (Azure AD, multi-tenant).
#   Redirect URI:  <OAUTH_CALLBACK_BASE_URL or APP_BASE_URL>/api/v1/chat/teams/callback
#   Delegated scopes: TeamworkTag.ReadWrite, Team.ReadBasic.All, Channel.ReadBasic.All,
#                      ChannelMessage.Send, User.Read.All, offline_access
#   No signing secret: there is no Teams webhook, so nothing to verify inbound.
#   A tenant admin completing the connect flow sees a "Consent on behalf of
#   your organization" checkbox, since every scope above requires admin
#   consent — checking it covers the whole org, not just that admin.
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=

#test app
