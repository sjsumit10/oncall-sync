# Production env for docker-compose.prod.yml (api + worker only — no
# postgres/redis containers). Copy to .env.production on the VPS and fill in;
# never commit the real file.

ENVIRONMENT=production
DEBUG=false

# Host ports published on the VPS. Put a reverse proxy / ALB in front of
# API_PORT for TLS — this compose file does not terminate TLS itself.
API_PORT=8000
WORKER_METRICS_PORT=9100

# The API's own public URL (what the reverse proxy / ALB in front of it
# serves, e.g. https://api.yourdomain.com) and the frontend's public URL
# (the CloudFront distribution, e.g. https://app.yourdomain.com). OAuth
# redirect URIs are derived from APP_BASE_URL; WEB_BASE_URL is the only
# origin CORS allows and the only place callbacks redirect to — and, since
# cookies are SameSite=Lax, api./app. need to share a registrable domain
# (both under yourdomain.com) or login will silently fail cross-site. A bare
# *.cloudfront.net domain does NOT share a site with the API's domain — put a
# custom domain on the CloudFront distribution.
APP_BASE_URL=https://api.yourdomain.com
WEB_BASE_URL=https://app.yourdomain.com
OAUTH_CALLBACK_BASE_URL=

# Supabase: Project Settings -> Database -> Connection string. Use the
# *direct* (non-pooler, port 5432) connection for DATABASE_ADMIN_URL — it
# needs to run DDL (CREATE ROLE, migrations). DATABASE_URL's oncall_app role
# is created for you by `python scripts/bootstrap_db.py`, run once before the
# first `alembic upgrade head` — reuse the same host/db, just a different
# role, in both URLs below. Supabase requires TLS; ?ssl=require makes asyncpg
# negotiate it.
DATABASE_URL=postgresql+asyncpg://oncall_app:<app-role-password>@db.<project-ref>.supabase.co:5432/postgres?ssl=require
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:<supabase-db-password>@db.<project-ref>.supabase.co:5432/postgres?ssl=require

# Upstash: Redis REST/TLS URL from the console — rediss://, not redis://.
REDIS_URL=rediss://default:<upstash-password>@<upstash-endpoint>.upstash.io:6379

# Wraps per-org data encryption keys. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Back this up separately from the database — losing it makes every stored
# provider credential undecryptable.
CREDENTIAL_KEK=
SESSION_SECRET=
COOKIE_SECURE=true

# PagerDuty OAuth app (API-key fallback needs no credentials here)
PAGERDUTY_CLIENT_ID=
PAGERDUTY_CLIENT_SECRET=

# Slack app. Redirect URL / Event URL are <APP_BASE_URL>/api/v1/chat/slack/callback
# and <APP_BASE_URL>/api/v1/webhooks/slack/events — see .env.example for the
# full scope list.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Microsoft Teams app (Azure AD, multi-tenant). Redirect URI is
# <APP_BASE_URL>/api/v1/chat/teams/callback — see .env.example for scopes.
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_INTEGRATION_ENABLED=false

# Outbound email (password reset). Leave SMTP_HOST empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=On-Call Sync
